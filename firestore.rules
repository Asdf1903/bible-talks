// =========================================================
// Reglas de seguridad de Firestore: Bible Talks
// Quién puede leer y escribir cada cosa. Es "la llave" del sitio.
//
// Cómo se sube: consola de Firebase → Firestore Database → pestaña Rules →
// borrar lo que hay, pegar TODO este archivo → Publish.
// (Subirlo igual en los dos proyectos: bible-talks-ee75e y bible-talks-test.)
//
// Quién es "admin": cada persona que puede publicar tiene un documento en la
// colección `admins` cuyo nombre es su número de cuenta (UID). Esos documentos
// se crean A MANO en la consola; nadie los puede crear desde el sitio.
// Así no aparecen correos en este archivo (el repo es público).
// =========================================================
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Lista de admins: cada quien puede ver solo SU propio documento
    // (así el panel sabe si te deja entrar). Nadie escribe desde el sitio.
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Lecturas
    // - Público: solo las publicadas cuya fecha ya llegó.
    // - Neil e Isra: todo (borradores, programadas, papelera).
    match /readings/{readingId} {
      allow read: if isAdmin() ||
        (resource.data.status == "published" && resource.data.publishAt <= request.time);
      allow create, update: if isAdmin() &&
        request.resource.data.status in ["draft", "scheduled", "published", "trashed"] &&
        request.resource.data.category in ["good-news", "doctrine", "bible-study", "prophecy"] &&
        request.resource.data.title is string &&
        request.resource.data.bodyHtml is string;
      // Nada se borra de verdad: se manda a la papelera (status "trashed")
      allow delete: if false;
    }

    // Historial: copia de cómo estaba un estudio antes de cada cambio.
    // Se agregan, nunca se cambian ni se borran.
    match /readings/{readingId}/versions/{versionId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    // Notas rápidas del panel ("Leave a note"): solo Neil e Isra.
    // Van aparte de las lecturas para que nunca sean públicas.
    match /notes/{readingId} {
      allow read, write: if isAdmin();
    }

    // Datos del sitio público que arma el panel:
    // - site/upcoming: títulos y fechas de lo programado ("Coming soon" en la portada).
    //   (Los estudios programados no se pueden leer todavía; esto es solo la lista.)
    // - site/home: el banner de la portada (más adelante lo edita Neil).
    // Todos lo pueden leer; solo Neil e Isra lo cambian.
    match /site/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Mensajes del formulario de Contact (index.html#contact)
    // - Cualquiera puede MANDAR uno, solo si viene bien formado (campos exactos y tamaños).
    // - Solo Neil e Isra los LEEN y les cambian el estado (leído / archivado) desde el panel.
    // - Nadie los borra desde el sitio.
    match /messages/{messageId} {
      allow create: if request.resource.data.keys().hasOnly(["name", "email", "type", "message", "status", "createdAt"]) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100 &&
        request.resource.data.email is string && request.resource.data.email.size() <= 200 &&
        request.resource.data.email.matches("^[^@\\s]+@[^@\\s]+[.][^@\\s]+$") &&
        request.resource.data.type in ["question", "suggestion", "observation", "request", "thanks"] &&
        request.resource.data.message is string &&
        request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 5000 &&
        request.resource.data.status == "new" &&
        request.resource.data.createdAt == request.time;
      allow read: if isAdmin();
      allow update: if isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status"]) &&
        request.resource.data.status in ["new", "read", "archived"];
      allow delete: if false;
    }

    // Todo lo demás: cerrado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
